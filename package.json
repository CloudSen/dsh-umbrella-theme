{
  "name": "dsh-umbrella-theme",
  "version": "1.0.0",
  "description": "Umbrella Corporation theme for DeepSeek Harness: a black-and-red dark scheme with terminal-green prose, a grey-and-white light scheme, a red-and-white umbrella watermark that slowly spins about its own vertical axis, and a HUD frame. No characters.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "appearance",
    "umbrella",
    "resident-evil"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "homepage": "https://github.com/CloudSen/dsh-umbrella-theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CloudSen/dsh-umbrella-theme.git"
  },
  "bugs": {
    "url": "https://github.com/CloudSen/dsh-umbrella-theme/issues"
  }
}
